{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Flux Developer Docs",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "fonts": {
    "family": "Geist"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "pages": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "pages": [
          {
            "group": "Metadata Service",
            "pages": [
              "api/metadata/overview",
              "api/metadata/meta",
              "api/metadata/dek",
              "api/metadata/stats",
              "api/metadata/experimental"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "API Reference",
          "href": "/api/metadata/overview",
          "icon": "code"
        },
        {
          "anchor": "FluxDrop",
          "href": "https://fluxdrop.eu",
          "icon": "arrow-up-right-from-square"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@fluxorg.pl"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://fluxdrop.eu"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {}
  }
}