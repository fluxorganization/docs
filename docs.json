{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Flux Developer Docs",
  "colors": {
    "primary": "#6366F1",
    "light": "#818CF8",
    "dark": "#4F46E5"
  },
  "fonts": {
    "family": "Geist"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "pages": [
          {
            "group": "Getting Started",
            "pages": ["index", "quickstart"]
          }
        ]
      },
      {
        "tab": "Metadata Service",
        "pages": [
          {
            "group": "Core",
            "pages": [
              "api/metadata/overview",
              "api/metadata/meta",
              "api/metadata/dek",
              "api/metadata/stats"
            ]
          },
          {
            "group": "Experimental",
            "pages": ["api/metadata/experimental"]
          }
        ]
      },
      {
        "tab": "Thumbnail Service",
        "pages": [
          {
            "group": "Core",
            "pages": ["api/thumbnails/overview"]
          }
        ]
      },
      {
        "tab": "Flux Pass",
        "pages": [
          {
            "group": "Overview",
            "pages": ["api/fluxpass/overview"]
          },
          {
            "group": "Authentication",
            "pages": ["api/fluxpass/auth", "api/fluxpass/oauth"]
          },
          {
            "group": "User management",
            "pages": ["api/fluxpass/user", "api/fluxpass/connect"]
          },
          {
            "group": "Payments",
            "pages": ["api/fluxpass/payments"]
          },
          {
            "group": "Platform",
            "pages": [
              "api/fluxpass/admin",
              "api/fluxpass/audit",
              "api/fluxpass/health"
            ]
          }
        ]
      },
      {
        "tab": "Build on top",
        "pages": [
          "build-on-top"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "API Reference",
          "href": "/api/metadata/overview",
          "icon": "code"
        },
        {
          "anchor": "FluxDrop",
          "href": "https://fluxdrop.eu",
          "icon": "arrow-up-right-from-square"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/dark.png",
    "dark": "/logo/light.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@fluxorg.pl"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://fluxdrop.eu"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {}
  }
}
